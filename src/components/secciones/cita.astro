---
// Pide cita: banda partida 50/50 de borde a borde. A la izquierda, sobre rojo con grano: titular, texto, lo que
// conviene contar (`items: [{titulo, texto}]`, numerados), botón de WhatsApp (de site.yaml → contacto.whatsapp)
// y `nota`. A la derecha, sobre negro: formulario de cita (servicio, zona del cuerpo de `opciones` —cadena con «;»—,
// tamaño, fecha preferida e idea), que abre el correo. `boton_formulario` opcional. En móvil, una mitad sobre otra.
import { seccion, site, whatsapp, puntos, campo } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const pasos = s ? s.items.filter((it) => it && it.titulo) : [];
const wa = whatsapp(site.contacto.whatsapp, `Hola, quiero pedir cita en ${site.nombre}.`);
const boton = campo(s?.boton_formulario) || undefined;
const zonas = puntos(s?.opciones);
---

{
  s && (
    <section id={id} class="cita">
      <div class="cita-info banda-roja grano dentado">
        <div class="cita-mitad cita-mitad--izq">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
          {pasos.length > 0 && (
            <ol class="mt-10 grid gap-5">
              {pasos.map((it, i) => (
                <li class="cita-paso">
                  <span class="cita-paso-n" aria-hidden="true">{i + 1}</span>
                  <div>
                    <p class="cita-paso-titulo">{it.titulo}</p>
                    {it.texto && <p class="mt-1 opacity-90">{it.texto}</p>}
                  </div>
                </li>
              ))}
            </ol>
          )}
          {(wa || s.cta) && (
            <div class="mt-10 flex flex-wrap gap-3">
              {wa && (
                <a class="btn" href={wa} rel="noopener" target="_blank">
                  <Icono nombre="whatsapp" tam={20} />
                  WhatsApp
                </a>
              )}
              {s.cta && <a class="btn-sec" href={s.cta.url}>{s.cta.texto}</a>}
            </div>
          )}
          {s.nota && <p class="mt-6 text-sm opacity-85">{s.nota}</p>}
        </div>
      </div>
      <div class="cita-form banda-tinta">
        <div class="cita-mitad cita-mitad--der">
          <FormularioContacto prefijo={`${id}-f`} boton={boton} cita zonas={zonas} />
        </div>
      </div>
    </section>
  )
}

<style>
  .cita { display: grid; grid-template-columns: minmax(0, 1fr); }
  .cita-mitad { padding: var(--ritmo) 1rem; }
  .cita-form { border-top: 6px solid var(--c-fondo); }
  @media (min-width: 768px) { .cita-mitad { padding: var(--ritmo-md) 2rem; } }
  @media (min-width: 1024px) {
    .cita { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
    .cita-form { border-top: 0; }
    .cita-mitad--izq { padding-left: max(2rem, calc((100vw - var(--ancho)) / 2 + 2rem)); padding-right: 4rem; }
    .cita-mitad--der { padding-left: 4rem; padding-right: max(2rem, calc((100vw - var(--ancho)) / 2 + 2rem)); }
  }
  .cita-paso { display: flex; gap: 1.1rem; align-items: flex-start; }
  .cita-paso-n { flex-shrink: 0; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 2px solid currentColor; border-radius: 50%; font-family: var(--fuente-titulos); font-weight: 800; font-synthesis-weight: none; font-size: 1.25rem; line-height: 1; }
  .cita-paso-titulo { font-family: var(--fuente-titulos); font-weight: 800; font-synthesis-weight: none; font-size: 1.45rem; line-height: 1.1; }
</style>
