---
// Trabajos: banda negra con el titular y el botón (`cta`, p. ej. a Instagram) dentro del ancho máximo y, debajo,
// la `galeria: [ruta, ruta…]` en mosaico de borde a borde sin márgenes (4 columnas en escritorio, 2 en móvil):
// la primera foto ocupa el doble de alto y de ancho y las últimas se ensanchan para cerrar las filas sin huecos.
// Al pasar, velo rojo. Sin fotos, solo el titular.
import { seccion } from '../../data/site';
import { altGaleria } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const fotos = s ? s.galeria.filter(Boolean) : [];
// Celdas en 4 columnas: la primera cuenta 4; las que faltan para cerrar la última fila se reparten ensanchando las últimas.
const sobran = fotos.length > 1 ? (4 - ((fotos.length + 3) % 4)) % 4 : 0;
const ancha = (i: number) => i > 0 && i >= fotos.length - sobran;
const externo = (u?: string) => !!u && /^https?:\/\//.test(u);
---

{
  s && (
    <section id={Astro.props.id} class="galeria banda-tinta grano">
      <div class="contenedor seccion !pb-12 md:!pb-16">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
          {s.cta && (
            <p class="shrink-0">
              <a class="btn-sec" href={s.cta.url} {...(externo(s.cta.url) ? { rel: 'noopener', target: '_blank' } : {})}>{s.cta.texto}</a>
            </p>
          )}
        </div>
      </div>
      {fotos.length > 0 && (
        <ul class:list={['mosaico', { 'mosaico--una': fotos.length === 1 }]}>
          {fotos.map((src, i) => (
            <li class:list={['mosaico-celda', { 'mosaico-celda--grande': i === 0 && fotos.length > 1, 'mosaico-celda--ancha': ancha(i) }]}>
              <Imagen src={src} alt={altGaleria(i)} ancho={i === 0 ? 1400 : 800} alto={i === 0 ? 1400 : 800} class="h-full w-full object-cover" />
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<style>
  .mosaico { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 46vw; grid-auto-flow: dense; border-top: 6px solid var(--c-primario); }
  .mosaico--una { grid-template-columns: minmax(0, 1fr); grid-auto-rows: clamp(16rem, 50vw, 40rem); }
  .mosaico-celda { position: relative; overflow: hidden; min-width: 0; background: var(--negro); }
  .mosaico-celda--grande { grid-column: span 2; grid-row: span 2; }
  .mosaico-celda--ancha { grid-column: span 2; }
  .mosaico-celda::after { content: ""; position: absolute; inset: 0; background: var(--c-primario); mix-blend-mode: multiply; opacity: 0; transition: opacity .3s ease; pointer-events: none; }
  .mosaico-celda:hover::after { opacity: .55; }
  .mosaico-celda :global(img) { transition: transform .6s ease; }
  .mosaico-celda:hover :global(img) { transform: scale(1.05); }
  @media (min-width: 768px) {
    .mosaico { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(12rem, 23vw, 24rem); }
  }
</style>
