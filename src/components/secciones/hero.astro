---
// Portada partida a sangre: a la izquierda, sobre negro con grano, antetítulo, titular enorme en slab serif,
// `texto` y los dos botones (`cta`, `cta_secundario`); a la derecha, la foto (`imagen`) hasta el borde de la
// ventana, con la localidad en vertical. Debajo, una cinta roja de borde a borde con los `items` ({titulo, icono})
// separados por estrellas. En móvil, la foto va arriba a todo el ancho y el texto debajo. Sin foto, el texto
// ocupa todo el ancho. Sin items, no hay cinta.
import { seccion } from '../../data/site';
import { altHero, localidad } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const lugar = localidad();
---

{
  s && (
    <section id={id} class:list={['hero banda-tinta grano', { 'hero--sin-foto': !s.imagen }]}>
      <div class="hero-rejilla">
        <div class="hero-texto">
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h1 class="hero-titulo">{s.titulo}</h1>}
          {s.texto && <p class="hero-parrafo">{s.texto}</p>}
          {(s.cta || s.cta_secundario) && (
            <div class="mt-9 flex flex-wrap gap-3">
              {s.cta && <a class="btn" href={s.cta.url}>{s.cta.texto}</a>}
              {s.cta_secundario && <a class="btn-sec" href={s.cta_secundario.url}>{s.cta_secundario.texto}</a>}
            </div>
          )}
        </div>
        {s.imagen && (
          <div class="hero-foto">
            <Imagen src={s.imagen} alt={altHero()} ancho={1400} alto={1400} prioridad={primera} class="h-full w-full object-cover" />
            {lugar && <p class="hero-lugar etiqueta-mayus" aria-hidden="true"><span>✶</span> {lugar} <span>✶</span></p>}
          </div>
        )}
      </div>
      {s.items.length > 0 && (
        <ul class="hero-cinta banda-roja dentado">
          {s.items.map((it, i) => (
            <li class="hero-cinta-item">
              {i > 0 && <span class="hero-cinta-estrella" aria-hidden="true">✶</span>}
              {it.icono && <Icono nombre={it.icono} tam={20} class="shrink-0" />}
              <span>{it.titulo}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<style>
  .hero { display: flex; flex-direction: column; min-height: calc(100svh - var(--alto-cabecera)); }
  .hero-rejilla { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr); }
  .hero-foto { position: relative; order: -1; height: 46svh; min-height: 15rem; overflow: hidden; background: var(--negro); }
  .hero-foto :global(img) { filter: contrast(1.06) saturate(.9); }
  .hero-foto::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, var(--c-fondo) 0%, transparent 35%); pointer-events: none; }
  .hero-lugar { display: none; }
  .hero-texto { display: flex; flex-direction: column; justify-content: center; padding: 1.5rem 1rem 3.5rem; }
  .hero-titulo { margin-top: 1rem; font-size: clamp(2.75rem, 11.5vw, 4.5rem); line-height: .92; letter-spacing: -0.025em; max-width: 12ch; overflow-wrap: break-word; }
  .hero-parrafo { margin-top: 1.5rem; max-width: 36rem; font-size: 1.125rem; opacity: .85; }
  .hero-cinta { display: flex; flex-wrap: wrap; justify-content: center; gap: .9rem 1.75rem; padding: 1.1rem 1rem; font-family: var(--fuente-texto); font-size: .8rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .hero-cinta-item { display: inline-flex; align-items: center; gap: .65rem; }
  .hero-cinta-estrella { display: none; margin-right: 1.1rem; font-size: 1rem; letter-spacing: 0; }
  @media (min-width: 768px) {
    .hero-texto { padding: 3rem 2rem 4.5rem; }
    .hero-titulo { font-size: clamp(4rem, 9vw, 6rem); }
    .hero-cinta { flex-wrap: nowrap; gap: 1.1rem; padding-block: 1.35rem; }
    .hero-cinta-estrella { display: inline; }
  }
  @media (min-width: 1024px) {
    .hero-rejilla { grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); }
    .hero--sin-foto .hero-rejilla { grid-template-columns: minmax(0, 1fr); }
    .hero-foto { order: 0; height: auto; min-height: 0; }
    .hero-foto::after { background: linear-gradient(90deg, color-mix(in srgb, var(--c-fondo) 55%, transparent) 0%, transparent 22%); }
    .hero-texto { padding: 4rem 3.5rem 5rem max(2.5rem, calc((100vw - var(--ancho)) / 2 + 2rem)); }
    .hero-titulo { font-size: clamp(4.5rem, 6.6vw, 7rem); max-width: 11ch; }
    .hero--sin-foto .hero-titulo { max-width: 16ch; font-size: clamp(4.5rem, 8.5vw, 8.5rem); }
    .hero-lugar { display: flex; align-items: center; gap: .8rem; position: absolute; left: 0; top: 0; bottom: 0; z-index: 1; padding: 1.5rem .7rem; writing-mode: vertical-rl; transform: rotate(180deg); justify-content: center; background: var(--c-primario); color: var(--sobre-primario); }
  }
</style>
