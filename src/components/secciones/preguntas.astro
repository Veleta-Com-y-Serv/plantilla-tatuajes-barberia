---
// Cuidados y preguntas frecuentes: banda negra partida 50/50 a sangre. A la izquierda, la foto (`imagen`, opcional)
// hasta el borde de la ventana; a la derecha, titular y acordeón nativo <details> (sin JavaScript) con la pregunta en
// slab serif y un signo en cuadro rojo. Sin foto, el titular va a la izquierda y el acordeón a la derecha.
// Campos: `preguntas[]` (pregunta, respuesta). Sin preguntas no se pinta. Sirve de diseño para apartados nuevos.
import { seccion } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <section id={Astro.props.id} class:list={['faq-banda banda-tinta grano', { 'faq-banda--foto': !!s.imagen }]}>
      {s.imagen && (
        <div class="faq-foto">
          <Imagen src={s.imagen} alt={altSeccion(s)} ancho={900} alto={1200} class="h-full w-full object-cover" />
        </div>
      )}
      <div class="faq-cuerpo">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="faq-titular" />
        <div class="faq-lista">
          {preguntas.map((p) => (
            <details class="faq">
              <summary>
                <span class="faq-pregunta">{p.pregunta}</span>
                <span class="faq-signo" aria-hidden="true" />
              </summary>
              {p.respuesta && <p class="faq-respuesta">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq-banda { display: grid; grid-template-columns: minmax(0, 1fr); }
  .faq-foto { height: 62vw; max-height: 30rem; overflow: hidden; border-bottom: 6px solid var(--c-primario); }
  .faq-foto :global(img) { filter: contrast(1.05) saturate(.85); }
  .faq-cuerpo { padding: var(--ritmo) 1rem; }
  .faq-cuerpo :global(.faq-titular) { margin-bottom: 2.25rem; }
  .faq-cuerpo :global(.titulo-seccion) { font-size: clamp(2.3rem, 4vw, 3.75rem); }
  @media (min-width: 768px) { .faq-cuerpo { padding: var(--ritmo-md) 2rem; } }
  @media (min-width: 1024px) {
    .faq-banda { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .faq-banda:not(.faq-banda--foto) .faq-cuerpo { grid-column: 1 / -1; width: 100%; max-width: var(--ancho); margin-inline: auto; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 4rem; }
    .faq-foto { height: auto; max-height: none; border-bottom: 0; border-right: 6px solid var(--c-primario); }
    .faq-banda--foto .faq-cuerpo { padding-left: 4rem; padding-right: max(2rem, calc((100vw - var(--ancho)) / 2 + 2rem)); }
  }
  .faq-lista { border-top: 2px solid var(--linea); }
  .faq { border-bottom: 2px solid var(--linea); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; min-height: 3rem; padding-block: 1.15rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-pregunta { font-family: var(--fuente-titulos); font-weight: 800; font-synthesis-weight: none; font-size: 1.3rem; line-height: 1.15; }
  .faq-signo { position: relative; flex-shrink: 0; width: 2.25rem; height: 2.25rem; border: 2px solid var(--resalte); }
  .faq-signo::before, .faq-signo::after { content: ""; position: absolute; left: 50%; top: 50%; width: .9rem; height: 2px; background: var(--resalte); transform: translate(-50%, -50%); transition: transform .2s ease; }
  .faq-signo::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq[open] .faq-signo { background: var(--c-acento); border-color: var(--c-acento); }
  .faq[open] .faq-signo::before, .faq[open] .faq-signo::after { background: var(--sobre-acento); }
  .faq[open] .faq-signo::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq-respuesta { padding-bottom: 1.4rem; padding-right: 3.25rem; opacity: .8; }
</style>
