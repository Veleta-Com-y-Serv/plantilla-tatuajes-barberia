---
// Servicios y precios, como la lista pintada de una barbería antigua, sobre banda hueso con grano:
// arriba una franja de foto a sangre (`imagen`, opcional), luego titular y texto en dos columnas y la lista
// `servicios: [{nombre, texto, precio, duracion, categoria, destacado}]` agrupada por `categoria` (una columna
// por grupo en escritorio, hasta tres). Cada fila: nombre, puntos guía y precio; debajo, texto y duración.
// `destacado: true` = estrella roja. Precio vacío = no se pinta (sin puntos guía). `nota` y `cta` opcionales.
import { seccion, porCategoria } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const grupos = s ? porCategoria(s.servicios) : [];
const columnas = Math.min(Math.max(grupos.length, 1), 3);
---

{
  s && (
    <section id={Astro.props.id} class="servicios banda-hueso grano">
      {s.imagen && (
        <div class="servicios-franja">
          <Imagen src={s.imagen} alt={altSeccion(s)} ancho={2100} alto={900} class="h-full w-full object-cover" />
        </div>
      )}
      <div class="seccion contenedor">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} class="!mb-0" />
          {s.texto && <p class="titular-texto lg:!mt-0">{s.texto}</p>}
        </div>
        {grupos.length > 0 && (
          <div class="servicios-grupos" style={`--cols:${columnas}`}>
            {grupos.map((g, n) => (
              <div class="servicios-grupo">
                {g.categoria && (
                  <h3 class="servicios-categoria">
                    <span class="etiqueta-mayus resalte">Nº {String(n + 1).padStart(2, '0')}</span>
                    {g.categoria}
                  </h3>
                )}
                <ul>
                  {g.servicios.map((x) => (
                    <li class="servicio">
                      <p class="servicio-fila">
                        <span class="servicio-nombre">
                          {x.destacado === true && <span class="estrella mr-1.5" aria-hidden="true">✶</span>}
                          {x.nombre}
                        </span>
                        {x.precio && <span class="servicio-guia" aria-hidden="true" />}
                        {x.precio && <span class="servicio-precio">{x.precio}</span>}
                      </p>
                      {(x.texto || x.duracion) && (
                        <p class="servicio-texto">
                          {x.texto}
                          {x.duracion && <span class="servicio-duracion">{x.duracion}</span>}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
        {(s.nota || s.cta) && (
          <div class="mt-12 flex flex-col gap-6 border-t-2 border-current pt-8 md:flex-row md:items-center md:justify-between">
            {s.nota && <p class="max-w-2xl text-sm opacity-80">{s.nota}</p>}
            {s.cta && <p class="shrink-0"><a class="btn" href={s.cta.url}>{s.cta.texto}</a></p>}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .servicios-franja { height: clamp(11rem, 30vw, 26rem); overflow: hidden; border-bottom: 6px solid var(--c-primario); }
  .servicios-franja :global(img) { filter: grayscale(.35) contrast(1.08); }
  .servicios-grupos { display: grid; gap: 3rem; margin-top: 3.5rem; }
  @media (min-width: 900px) { .servicios-grupos { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 3.5rem; } }
  .servicios-categoria { display: flex; flex-direction: column; gap: .5rem; padding-bottom: 1rem; margin-bottom: .5rem; border-bottom: 3px double currentColor; font-size: clamp(2rem, 4vw, 2.75rem); }
  .servicio { padding-block: 1rem; border-bottom: 1px dashed color-mix(in srgb, currentColor 35%, transparent); }
  .servicio-fila { display: flex; align-items: baseline; gap: .6rem; }
  .servicio-nombre { font-family: var(--fuente-titulos); font-weight: 800; font-synthesis-weight: none; font-size: 1.25rem; line-height: 1.15; }
  .servicio-guia { flex: 1 1 1.5rem; min-width: 1.5rem; border-bottom: 2px dotted color-mix(in srgb, currentColor 45%, transparent); transform: translateY(-.3rem); }
  .servicio-precio { flex-shrink: 0; font-family: var(--fuente-titulos); font-weight: 800; font-synthesis-weight: none; font-size: 1.25rem; color: var(--resalte); white-space: nowrap; }
  .servicio-texto { margin-top: .35rem; font-size: .95rem; opacity: .78; }
  .servicio-duracion { display: inline-block; margin-left: .6rem; padding: 0 .45rem; font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; border: 1px solid currentColor; vertical-align: .1em; white-space: nowrap; }
</style>
