---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Diseño «rótulo de barbería»: banda negra con grano, migas y hero partido (título en slab serif, texto, duración y
// precio, botones de cita y WhatsApp; a la derecha la foto en blanco y negro con sombra roja o, sin foto, su icono
// enorme en un sello); banda hueso con el `detalle` y la lista de datos con filetes; banda negra con la cita al lado;
// fotos (`imagenes`) a sangre y otros servicios de la misma lista en banda roja dentada.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const cita = seccion('cita') ? '/#cita' : site.boton_cabecera?.url || '/#contacto';
const textoCita = site.boton_cabecera?.texto || 'Pide cita';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const duracion = f.datos.find((d) => d.clave === 'duracion')?.valor ?? '';
const datos = f.datos.filter((d) => d.clave !== 'precio' && d.clave !== 'duracion');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-tinta grano ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="ficha-lead">{f.texto}</p>}
          {(duracion || f.precio) && (
            <p class="ficha-chips">
              {f.precio && <span class="ficha-precio">{f.precio}</span>}
              {duracion && <span class="ficha-duracion">{duracion}</span>}
            </p>
          )}
          <div class="ficha-botones">
            <a class="btn" href={cita}>{textoCita}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'lapiz'} tam={110} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda-hueso grano dentado ficha-cuerpo-banda">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio || duracion) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo"><span class="estrella" aria-hidden="true">✶</span> En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {duracion && <div><dt>Duración</dt><dd>{duracion}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita banda-negra">
          <p class="ficha-cita-titulo">¿Tienes una idea?</p>
          <p>Cuéntanosla y te respondemos con presupuesto y fecha.</p>
          <a class="btn" href={cita}>{textoCita}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda-tinta grano" aria-label={`Fotos de ${f.titulo}`}>
      <ul class="ficha-galeria">
        {f.imagenes.map((src, i) => (
          <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
        ))}
      </ul>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda-roja grano dentado ficha-otras-banda">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros servicios de la casa" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-otra-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn" href={`/#${f.idSeccion}`}>Ver todos los servicios</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 7vw, 6rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "✶"; color: var(--resalte); font-size: .7rem; }
  .migas a { color: var(--resalte); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.4rem, 7vw, 5.5rem); overflow-wrap: anywhere; }
  .ficha-lead { margin-top: 1.25rem; font-size: 1.2rem; max-width: 36rem; opacity: .88; }
  .ficha-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 1.5rem; }
  .ficha-precio { font-family: var(--fuente-titulos); font-weight: 800; font-synthesis-weight: none; font-size: 1.6rem; color: var(--resalte); }
  .ficha-duracion { padding: .1rem .55rem; font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; border: 1px solid currentColor; }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a, .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; overflow: hidden; box-shadow: 10px 10px 0 var(--c-primario); background: var(--negro); }
  .ficha-foto :global(img) { filter: grayscale(.35) contrast(1.08); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; border: 3px double var(--resalte); color: var(--resalte); box-shadow: 10px 10px 0 var(--c-primario); }
  .ficha-cuerpo-banda { padding-block: clamp(3.5rem, 8vw, 6.5rem); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.28rem; font-weight: 500; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.5rem; margin-bottom: .75rem; padding-bottom: .75rem; border-bottom: 3px double currentColor; overflow-wrap: anywhere; }
  .ficha-datos .ficha-precio { font-size: 1.25rem; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-bottom: 1px dashed color-mix(in srgb, currentColor 35%, transparent); }
  .ficha-datos dt { font-size: .75rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; opacity: .75; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-cita { display: grid; gap: .9rem; padding: 1.75rem 1.5rem; border-top: 6px solid var(--c-primario); }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.6rem; font-weight: 800; font-synthesis-weight: none; line-height: 1.1; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 700; color: var(--resalte); text-decoration: none; }
  .ficha-galeria { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; }
  .ficha-galeria :global(img) { filter: grayscale(.35) contrast(1.08); }
  .ficha-otras-banda { padding-block: clamp(3.5rem, 8vw, 6rem); }
  .ficha-otras { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; background: var(--c-fondo); color: var(--c-texto); border: 3px double var(--c-texto); }
  .ficha-otra h3 { font-size: 1.5rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; overflow-wrap: anywhere; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-texto); outline-offset: 3px; }
  .ficha-otra p { opacity: .85; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-precio { font-family: var(--fuente-titulos); font-weight: 800; font-synthesis-weight: none; font-size: 1.25rem; color: var(--rojo-claro); }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-size: .75rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 5rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 7rem; }
  }
</style>
